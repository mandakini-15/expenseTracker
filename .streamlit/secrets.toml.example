# Copy this file to .streamlit/secrets.toml for local testing against a cloud DB,
# or paste its contents into your Streamlit Community Cloud app's "Secrets" settings.
#
# If this is left unconfigured, the app automatically falls back to a local
# SQLite file (expenses.db) — fine for local use, but that file does NOT
# persist across redeploys on Streamlit Community Cloud.
#
# To persist data in the cloud, create a free Postgres database (e.g. at
# supabase.com or neon.tech) and paste its connection string below.

[database]
url = "postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres"
